# Replicate API Token for Music Generation (MusicGen)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# OpenAI API Key for Metadata and Album Art (GPT-4, DALL-E 3)
OPENAI_API_KEY=your_openai_api_key_here

# Suno AI Session Token (extracted from browser cookies)
SUNO_SESSION_TOKEN=your_suno_session_token_here

# Udio AI OAuth Token (extracted from browser cookies: sb-api-auth-token)
UDIO_OAUTH_TOKEN=your_udio_oauth_token_here

# Path to Client Secrets file for YouTube Upload (JSON file downloaded from Google Cloud Console)
GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json
